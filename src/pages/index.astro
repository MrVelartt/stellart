---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<section class="hero">
		<h1>Stellart</h1>
		<p>
			Engineering · AI · Automation · Future Systems
		</p>

		<p>
			Building intelligent ecosystems through software,
			data and symbolic architectures.
		</p>
	</section>
</Layout>

<style>
.hero{
	display:flex;
	flex-direction:column;
	justify-content:center;
	align-items:center;
	min-height:80vh;
	text-align:center;
	padding:2rem;
}

h1{
	font-size:4rem;
	margin-bottom:1rem;
}

p{
	max-width:700px;
	line-height:1.6;
}
</style>
---
import Layout from '../layouts/Layout.astro';
---

<Layout>

  <!-- Hero -->
  <section class="hero">
    <!-- Canvas partículas -->
    <canvas id="particles-canvas"></canvas>

    <!-- Orbes de luz -->
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>

    <!-- Grid (solo mitad derecha) -->
    <div class="grid-bg"></div>

    <div class="container hero-inner">
      <p class="eyebrow fade-in-1">Arquitectura empresarial — desde 2020</p>
      <h1 class="fade-in-2">
        Diseñamos los sistemas<br /><em>que faltan</em> para que tus<br />decisiones tengan respaldo.
      </h1>
      <p class="hero-subtitle fade-in-3">
        Auditamos tu operación. Construimos el software a medida. Implementamos los tableros de KPIs.
        Tu negocio deja de funcionar por intuición y empieza a operar con datos.
      </p>
      <div class="hero-ctas fade-in-4">
        <a href="/contacto" class="btn btn-primary btn-arrow">Agendar diagnóstico <span class="arrow">→</span></a>
        <a href="/contacto#descarga" class="btn btn-secondary">Descargar guía técnica</a>
      </div>

      <!-- Scroll line -->
      <div class="scroll-line fade-in-6" aria-hidden="true">
        <span class="scroll-line-bar"></span>
      </div>
    </div>

    <!-- Stats bar -->
    <div class="stats-bar fade-in-5">
      <div class="container stats-inner">
        <div class="stat-item">
          <span class="stat-num" data-target="48">0</span><span class="stat-suffix">+</span>
          <span class="stat-label">Clientes activos</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-num" data-target="130">0</span><span class="stat-suffix">+</span>
          <span class="stat-label">Sistemas implementados</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-num" data-target="98">0</span><span class="stat-suffix">%</span>
          <span class="stat-label">Satisfacción</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Problema -->
  <section class="section problema">
    <div class="container">
      <div class="section-header scroll-reveal">
        <p class="eyebrow">El problema</p>
        <h2>Tu empresa creció más rápido<br />que sus <em>sistemas</em>.</h2>
      </div>
      <div class="problema-grid">
        <div class="problema-card scroll-reveal">
          <span class="card-number">01</span>
          <h3>Decisiones por intuición</h3>
          <p>Reportes en Excel que nadie confía. KPIs que cada área calcula distinto. Reuniones que terminan sin acción.</p>
        </div>
        <div class="problema-card scroll-reveal">
          <span class="card-number">02</span>
          <h3>Procesos desconectados</h3>
          <p>Ventas, operaciones y finanzas viven en mundos paralelos. La información se pierde entre departamentos.</p>
        </div>
        <div class="problema-card scroll-reveal">
          <span class="card-number">03</span>
          <h3>Software que no escala</h3>
          <p>Sistemas hechos a las prisas que hoy frenan el crecimiento. Cada cambio cuesta meses y miles de dólares.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Servicios -->
  <section class="section servicios-home">
    <div class="container">
      <div class="section-header scroll-reveal">
        <p class="eyebrow">Cómo trabajamos</p>
        <h2>Tres servicios. Uno lleva<br />naturalmente al <em>siguiente</em>.</h2>
      </div>
      <div class="servicios-list scroll-reveal">
        <a href="/servicios#diagnostico" class="servicio-row">
          <span class="servicio-num">01</span>
          <div class="servicio-info">
            <h3>Diagnóstico de arquitectura</h3>
            <p>Mapeamos tu operación completa e identificamos las brechas críticas con un roadmap priorizado.</p>
          </div>
          <div class="servicio-meta">
            <span class="servicio-time">2–3 semanas</span>
            <span class="servicio-arrow">→</span>
          </div>
        </a>
        <a href="/servicios#software" class="servicio-row">
          <span class="servicio-num">02</span>
          <div class="servicio-info">
            <h3>Software a medida</h3>
            <p>Construimos exactamente lo que tu operación necesita: sin bloatware, sin licencias innecesarias.</p>
          </div>
          <div class="servicio-meta">
            <span class="servicio-time">6–16 semanas</span>
            <span class="servicio-arrow">→</span>
          </div>
        </a>
        <a href="/servicios#kpis" class="servicio-row">
          <span class="servicio-num">03</span>
          <div class="servicio-info">
            <h3>Dashboards & KPIs</h3>
            <p>Tableros en tiempo real que conectan todas tus fuentes de datos en una vista ejecutiva.</p>
          </div>
          <div class="servicio-meta">
            <span class="servicio-time">3–6 semanas</span>
            <span class="servicio-arrow">→</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Casos -->
  <section class="section casos">
    <div class="container">
      <div class="section-header scroll-reveal">
        <p class="eyebrow">Casos reales</p>
        <h2>Empresas que dejaron de<br />operar a <em>ciegas</em>.</h2>
      </div>
      <div class="casos-grid">
        <div class="caso-card scroll-reveal">
          <div class="caso-img">
            <img src="/images/caso-1.png" alt="Caso distribución" loading="lazy" />
          </div>
          <div class="caso-body">
            <span class="caso-tag">Distribución</span>
            <h3>Trazabilidad end-to-end para 40+ rutas diarias</h3>
            <p>Plataforma de trazabilidad end-to-end para una empresa de distribución con 40+ rutas diarias.</p>
            <div class="caso-metrics">
              <div class="caso-metric">
                <span class="metric-value">−68%</span>
                <span class="metric-label">Errores de entrega</span>
              </div>
              <div class="caso-metric">
                <span class="metric-value">3×</span>
                <span class="metric-label">Velocidad de despacho</span>
              </div>
            </div>
          </div>
        </div>
        <div class="caso-card scroll-reveal">
          <div class="caso-img">
            <img src="/images/caso-2.png" alt="Caso manufactura" loading="lazy" />
          </div>
          <div class="caso-body">
            <span class="caso-tag">Manufactura</span>
            <h3>ERP ligero para planta con 3 líneas de producción</h3>
            <p>Sistema de control de planta que unificó inventario, producción y ventas en una sola plataforma.</p>
            <div class="caso-metrics">
              <div class="caso-metric">
                <span class="metric-value">−40%</span>
                <span class="metric-label">Tiempo de reporte</span>
              </div>
              <div class="caso-metric">
                <span class="metric-value">+22%</span>
                <span class="metric-label">Eficiencia operativa</span>
              </div>
            </div>
          </div>
        </div>
        <div class="caso-card scroll-reveal">
          <div class="caso-img">
            <img src="/images/caso-3.png" alt="Caso retail" loading="lazy" />
          </div>
          <div class="caso-body">
            <span class="caso-tag">Retail</span>
            <h3>Dashboard ejecutivo para cadena de 12 tiendas</h3>
            <p>Tablero en tiempo real que centraliza ventas, inventario y márgenes de 12 puntos de venta.</p>
            <div class="caso-metrics">
              <div class="caso-metric">
                <span class="metric-value">RT</span>
                <span class="metric-label">Datos en tiempo real</span>
              </div>
              <div class="caso-metric">
                <span class="metric-value">12</span>
                <span class="metric-label">Tiendas conectadas</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Final -->
  <section class="section cta-final">
    <div class="container">
      <div class="cta-box scroll-reveal">
        <p class="eyebrow">Siguiente paso</p>
        <h2>¿Tu operación está lista<br />para escalar con <em>datos</em>?</h2>
        <p class="cta-desc">
          Agendamos una sesión de 45 minutos. Te entregamos un diagnóstico inicial sin costo
          y sin compromiso.
        </p>
        <div class="cta-btns">
          <a href="/contacto" class="btn btn-primary btn-arrow">Agendar diagnóstico <span class="arrow">→</span></a>
          <a href="/servicios" class="btn btn-secondary">Ver servicios</a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ── Hero ── */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  #particles-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }

  /* Orbes */
  .orb {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    z-index: 0;
    filter: blur(90px);
  }

  .orb-1 {
    width: 650px;
    height: 650px;
    background: rgba(120, 60, 220, 0.18);
    top: -120px;
    right: -80px;
    animation: orbFloat1 13s ease-in-out infinite;
  }

  .orb-2 {
    width: 500px;
    height: 500px;
    background: rgba(90, 30, 180, 0.14);
    bottom: 80px;
    left: -100px;
    animation: orbFloat2 17s ease-in-out infinite;
  }

  .orb-3 {
    width: 300px;
    height: 300px;
    background: rgba(255, 107, 43, 0.10);
    top: 40%;
    right: 18%;
    animation: orbFloat3 10s ease-in-out infinite;
  }

  @keyframes orbFloat1 {
    0%   { transform: translate(0, 0) scale(1); }
    33%  { transform: translate(-40px, 30px) scale(1.06); }
    66%  { transform: translate(25px, -20px) scale(0.96); }
    100% { transform: translate(0, 0) scale(1); }
  }

  @keyframes orbFloat2 {
    0%   { transform: translate(0, 0) scale(1); }
    40%  { transform: translate(50px, -35px) scale(1.08); }
    75%  { transform: translate(-20px, 20px) scale(0.94); }
    100% { transform: translate(0, 0) scale(1); }
  }

  @keyframes orbFloat3 {
    0%   { transform: translate(0, 0) scale(1); }
    50%  { transform: translate(-30px, 40px) scale(1.1); }
    100% { transform: translate(0, 0) scale(1); }
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: 860px;
    padding-top: 200px;
    padding-bottom: 60px;
    flex: 1;
  }

  .hero-inner .eyebrow {
    margin-bottom: 28px;
  }

  .hero-inner h1 {
    margin-bottom: 28px;
  }

  .hero-subtitle {
    font-size: 18px;
    line-height: 1.7;
    max-width: 580px;
    margin-bottom: 40px;
    font-weight: 300;
  }

  .hero-ctas {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 56px;
  }

  /* Scroll line */
  .scroll-line {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .scroll-line-bar {
    display: block;
    width: 1px;
    height: 36px;
    background: linear-gradient(to bottom, var(--accent), transparent);
    animation: scrollDown 1.8s ease-in-out infinite;
  }

  @keyframes scrollDown {
    0%   { transform: scaleY(0); transform-origin: top; opacity: 1; }
    50%  { transform: scaleY(1); transform-origin: top; opacity: 1; }
    51%  { transform: scaleY(1); transform-origin: bottom; }
    100% { transform: scaleY(0); transform-origin: bottom; opacity: 0; }
  }

  /* Stats bar */
  .stats-bar {
    position: relative;
    z-index: 2;
    background: rgba(9, 8, 15, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding: 28px 0;
  }

  .stats-inner {
    display: flex;
    align-items: center;
    gap: 0;
  }

  .stat-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    position: relative;
  }

  .stat-num {
    font-family: var(--font-display);
    font-size: 36px;
    font-weight: 700;
    color: var(--accent);
    line-height: 1;
    display: inline;
  }

  .stat-suffix {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 700;
    color: var(--accent);
    line-height: 1;
  }

  .stat-label {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.30);
  }

  .stat-divider {
    width: 1px;
    height: 44px;
    background: rgba(255, 255, 255, 0.08);
    flex-shrink: 0;
  }

  /* ── Problema ── */
  .problema {
    background: var(--bg-elevated);
  }

  .problema-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--border-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: 12px;
    overflow: hidden;
  }

  .problema-card {
    background: var(--bg-card);
    padding: 40px 36px;
    transition: background 0.2s, transform 0.2s;
  }

  .problema-card:hover {
    background: #110f1e;
    transform: translateY(-2px);
  }

  .card-number {
    display: block;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    color: var(--accent);
    margin-bottom: 20px;
    text-shadow: 0 0 8px var(--accent-glow);
  }

  .problema-card h3 {
    font-size: 22px;
    margin-bottom: 12px;
    line-height: 1.2;
  }

  .problema-card p {
    font-size: 15px;
    line-height: 1.65;
    font-weight: 300;
  }

  /* ── Servicios ── */
  .servicios-list {
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .servicio-row {
    display: grid;
    grid-template-columns: 64px 1fr auto;
    align-items: center;
    gap: 32px;
    padding: 36px 0;
    text-decoration: none;
    border-bottom: 1px solid var(--border-subtle);
    position: relative;
    overflow: hidden;
    transition: padding-left 0.3s ease;
  }

  .servicio-row:last-child {
    border-bottom: none;
  }

  .servicio-row::before {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 0;
    background: linear-gradient(90deg, rgba(255, 107, 43, 0.06) 0%, transparent 100%);
    transition: width 0.3s ease;
  }

  .servicio-row:hover::before {
    width: 100%;
  }

  .servicio-row:hover {
    padding-left: 8px;
  }

  .servicio-num {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    color: var(--accent);
    text-shadow: 0 0 8px var(--accent-glow);
  }

  .servicio-info h3 {
    font-size: clamp(22px, 2.5vw, 32px);
    margin-bottom: 6px;
    color: var(--text-primary);
  }

  .servicio-info p {
    font-size: 15px;
    color: var(--text-secondary);
    font-weight: 300;
  }

  .servicio-meta {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-shrink: 0;
  }

  .servicio-time {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    white-space: nowrap;
  }

  .servicio-arrow {
    font-size: 20px;
    color: var(--text-muted);
    transition: color 0.2s, transform 0.2s;
    display: block;
  }

  .servicio-row:hover .servicio-arrow {
    color: var(--accent);
    transform: translateX(4px);
  }

  /* ── Casos ── */
  .casos {
    background: var(--bg-elevated);
  }

  .casos-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .caso-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 12px;
    overflow: hidden;
    transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
    display: flex;
    flex-direction: column;
  }

  .caso-img {
    aspect-ratio: 16 / 9;
    background: #130f22;
    overflow: hidden;
    flex-shrink: 0;
  }

  .caso-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .caso-body {
    padding: 28px 32px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    flex: 1;
  }

  .caso-card:hover {
    border-color: var(--border-strong);
    transform: translateY(-3px);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.4);
  }

  .caso-tag {
    display: inline-flex;
    align-items: center;
    padding: 4px 12px;
    background: rgba(255, 107, 43, 0.08);
    color: var(--accent);
    border: 1px solid rgba(255, 107, 43, 0.2);
    border-radius: 100px;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    width: fit-content;
  }

  .caso-card h3 {
    font-size: 20px;
    line-height: 1.25;
  }

  .caso-body > p {
    font-size: 14px;
    line-height: 1.65;
    font-weight: 300;
    flex: 1;
  }

  .caso-metrics {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    padding-top: 20px;
    border-top: 1px solid var(--border-subtle);
  }

  .metric-value {
    display: block;
    font-family: var(--font-display);
    font-size: 28px;
    color: var(--accent);
    margin-bottom: 4px;
    line-height: 1;
  }

  .metric-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  /* ── CTA Final ── */
  .cta-final {
    background: var(--bg);
  }

  .cta-box {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 16px;
    padding: 80px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    position: relative;
    overflow: hidden;
  }

  .cta-box::before {
    content: '';
    position: absolute;
    bottom: -60px;
    left: 50%;
    transform: translateX(-50%);
    width: 480px;
    height: 200px;
    background: radial-gradient(ellipse at center, rgba(255, 107, 43, 0.14) 0%, transparent 70%);
    pointer-events: none;
  }

  .cta-box .eyebrow,
  .cta-box h2 {
    position: relative;
    z-index: 1;
  }

  .cta-desc {
    font-size: 17px;
    line-height: 1.7;
    max-width: 520px;
    font-weight: 300;
    position: relative;
    z-index: 1;
  }

  .cta-btns {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    justify-content: center;
    position: relative;
    z-index: 1;
  }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .problema-grid { grid-template-columns: 1fr; }
    .casos-grid    { grid-template-columns: 1fr 1fr; }
    .cta-box       { padding: 56px 48px; }
  }

  @media (max-width: 768px) {
    .hero-inner {
      padding-top: 140px;
      padding-bottom: 40px;
    }

    .hero-subtitle { font-size: 16px; }

    .stats-inner {
      flex-direction: column;
      gap: 20px;
    }

    .stat-divider {
      width: 40px;
      height: 1px;
    }

    .casos-grid    { grid-template-columns: 1fr; }

    .servicio-row  { grid-template-columns: 40px 1fr; }
    .servicio-meta { display: none; }

    .cta-box { padding: 48px 28px; }
  }
</style>

<script>
  /* ── Canvas particle system ── */
  (function () {
    const canvas = document.getElementById('particles-canvas') as HTMLCanvasElement;
    if (!canvas) return;
    const ctx = canvas.getContext('2d')!;

    let W = 0, H = 0;
    let mouse = { x: -9999, y: -9999 };

    function resize() {
      W = canvas.width  = canvas.offsetWidth  || window.innerWidth;
      H = canvas.height = canvas.offsetHeight || window.innerHeight;
    }
    window.addEventListener('resize', resize);
    requestAnimationFrame(resize);

    window.addEventListener('mousemove', (e) => {
      const rect = canvas.getBoundingClientRect();
      mouse.x = e.clientX - rect.left;
      mouse.y = e.clientY - rect.top;
    });

    window.addEventListener('mouseleave', () => {
      mouse.x = -9999; mouse.y = -9999;
    });

    type Particle = {
      x: number; y: number;
      vx: number; vy: number;
      size: number;
      r: number; g: number; b: number;
      opacity: number;
      targetOpacity: number;
      life: number;
      maxLife: number;
    };

    const COUNT = 130;
    const particles: Particle[] = [];

    function randColor(): [number, number, number] {
      const roll = Math.random();
      if (roll < 0.12)  return [255, 107, 43];   // 12% naranja
      if (roll < 0.28)  return [120, 60, 220];    // 16% púrpura
      return [255, 255, 255];                       // resto blanco
    }

    function makeParticle(aged = false): Particle {
      const [r, g, b] = randColor();
      const isWhite = r === 255 && g === 255 && b === 255;
      const maxOpacity = isWhite ? 0.28 + Math.random() * 0.18 : 0.45 + Math.random() * 0.3;
      const maxLife = 220 + Math.random() * 280;
      return {
        x: Math.random() * W,
        y: Math.random() * H,
        vx: (Math.random() - 0.5) * 0.56,
        vy: (Math.random() - 0.5) * 0.56,
        size: 0.3 + Math.random() * 1.4,
        r, g, b,
        opacity: aged ? maxOpacity : 0,
        targetOpacity: maxOpacity,
        life: aged ? Math.floor(Math.random() * maxLife) : 0,
        maxLife,
      };
    }

    for (let i = 0; i < COUNT; i++) particles.push(makeParticle(true));

    const REPULSION_RADIUS = 110;
    const LINK_RADIUS = 85;

    function draw() {
      ctx.clearRect(0, 0, W, H);

      for (const p of particles) {
        // Lifecycle
        p.life++;
        const dying = p.life > p.maxLife * 0.85;
        p.targetOpacity = dying ? 0 : (p.r === 255 && p.g === 255 && p.b === 255 ? 0.34 : 0.6);
        p.opacity += (p.targetOpacity - p.opacity) * 0.025;

        // Respawn
        if (p.life >= p.maxLife && p.opacity < 0.01) {
          Object.assign(p, makeParticle(false));
          continue;
        }

        // Mouse repulsion
        const dx = p.x - mouse.x;
        const dy = p.y - mouse.y;
        const dist = Math.sqrt(dx * dx + dy * dy);
        if (dist < REPULSION_RADIUS && dist > 0) {
          const force = (REPULSION_RADIUS - dist) / REPULSION_RADIUS * 0.8;
          p.vx += (dx / dist) * force;
          p.vy += (dy / dist) * force;
        }

        // Dampen velocity
        p.vx *= 0.98;
        p.vy *= 0.98;

        // Clamp speed
        const speed = Math.sqrt(p.vx * p.vx + p.vy * p.vy);
        if (speed > 1.4) { p.vx *= 1.4 / speed; p.vy *= 1.4 / speed; }

        p.x += p.vx;
        p.y += p.vy;

        // Wrap edges
        if (p.x < 0) p.x = W;
        if (p.x > W) p.x = 0;
        if (p.y < 0) p.y = H;
        if (p.y > H) p.y = 0;

        // Draw particle
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${p.r},${p.g},${p.b},${p.opacity})`;
        ctx.fill();
      }

      // Connection lines
      for (let i = 0; i < particles.length; i++) {
        for (let j = i + 1; j < particles.length; j++) {
          const a = particles[i], b = particles[j];
          const dx = a.x - b.x, dy = a.y - b.y;
          const d = Math.sqrt(dx * dx + dy * dy);
          if (d < LINK_RADIUS) {
            const alpha = (1 - d / LINK_RADIUS) * Math.min(a.opacity, b.opacity) * 0.55;
            ctx.beginPath();
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(b.x, b.y);
            ctx.strokeStyle = `rgba(160,112,255,${alpha})`;
            ctx.lineWidth = 0.6;
            ctx.stroke();
          }
        }
      }

      requestAnimationFrame(draw);
    }

    draw();
  })();

  /* ── Count-up stats ── */
  function countUp(el: Element, target: number, duration: number) {
    const start = performance.now();
    function step(now: number) {
      const t = Math.min((now - start) / duration, 1);
      const ease = 1 - Math.pow(1 - t, 3);
      (el as HTMLElement).textContent = Math.floor(ease * target).toString();
      if (t < 1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }

  const statsBar = document.querySelector('.stats-bar');
  if (statsBar) {
    const io = new IntersectionObserver((entries) => {
      if (entries[0].isIntersecting) {
        document.querySelectorAll('.stat-num').forEach((el) => {
          const target = parseInt((el as HTMLElement).dataset.target || '0', 10);
          countUp(el, target, 1900);
        });
        io.disconnect();
      }
    }, { threshold: 0.4 });
    io.observe(statsBar);
  }
</script>

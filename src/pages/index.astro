<script>
  /* ── Canvas particle system ── */
  (function () {
    const canvas = document.getElementById('particles-canvas') as HTMLCanvasElement;
    if (!canvas) return;
    const ctx = canvas.getContext('2d')!;

    let W = 0, H = 0;
    let mouse = { x: -9999, y: -9999 };

    function resize() {
      W = canvas.width  = canvas.offsetWidth  || window.innerWidth;
      H = canvas.height = canvas.offsetHeight || window.innerHeight;
    }
    window.addEventListener('resize', resize);
    requestAnimationFrame(resize);

    window.addEventListener('mousemove', (e) => {
      const rect = canvas.getBoundingClientRect();
      mouse.x = e.clientX - rect.left;
      mouse.y = e.clientY - rect.top;
    });

    window.addEventListener('mouseleave', () => {
      mouse.x = -9999; mouse.y = -9999;
    });

    type Particle = {
      x: number; y: number;
      vx: number; vy: number;
      size: number;
      r: number; g: number; b: number;
      opacity: number;
      targetOpacity: number;
      life: number;
      maxLife: number;
    };

    const COUNT = 130;
    const particles: Particle[] = [];

    function randColor(): [number, number, number] {
      const roll = Math.random();
      if (roll < 0.12)  return [255, 107, 43];   // 12% naranja
      if (roll < 0.28)  return [120, 60, 220];    // 16% púrpura
      return [255, 255, 255];                       // resto blanco
    }

    function makeParticle(aged = false): Particle {
      const [r, g, b] = randColor();
      const isWhite = r === 255 && g === 255 && b === 255;
      const maxOpacity = isWhite ? 0.28 + Math.random() * 0.18 : 0.45 + Math.random() * 0.3;
      const maxLife = 220 + Math.random() * 280;
      return {
        x: Math.random() * W,
        y: Math.random() * H,
        vx: (Math.random() - 0.5) * 0.56,
        vy: (Math.random() - 0.5) * 0.56,
        size: 0.3 + Math.random() * 1.4,
        r, g, b,
        opacity: aged ? maxOpacity : 0,
        targetOpacity: maxOpacity,
        life: aged ? Math.floor(Math.random() * maxLife) : 0,
        maxLife,
      };
    }

    for (let i = 0; i < COUNT; i++) particles.push(makeParticle(true));

    const REPULSION_RADIUS = 110;
    const LINK_RADIUS = 85;

    function draw() {
      ctx.clearRect(0, 0, W, H);

      for (const p of particles) {
        // Lifecycle
        p.life++;
        const dying = p.life > p.maxLife * 0.85;
        p.targetOpacity = dying ? 0 : (p.r === 255 && p.g === 255 && p.b === 255 ? 0.34 : 0.6);
        p.opacity += (p.targetOpacity - p.opacity) * 0.025;

        // Respawn
        if (p.life >= p.maxLife && p.opacity < 0.01) {
          Object.assign(p, makeParticle(false));
          continue;
        }

        // Mouse repulsion
        const dx = p.x - mouse.x;
        const dy = p.y - mouse.y;
        const dist = Math.sqrt(dx * dx + dy * dy);
        if (dist < REPULSION_RADIUS && dist > 0) {
          const force = (REPULSION_RADIUS - dist) / REPULSION_RADIUS * 0.8;
          p.vx += (dx / dist) * force;
          p.vy += (dy / dist) * force;
        }

        // Dampen velocity
        p.vx *= 0.98;
        p.vy *= 0.98;

        // Clamp speed
        const speed = Math.sqrt(p.vx * p.vx + p.vy * p.vy);
        if (speed > 1.4) { p.vx *= 1.4 / speed; p.vy *= 1.4 / speed; }

        p.x += p.vx;
        p.y += p.vy;

        // Wrap edges
        if (p.x < 0) p.x = W;
        if (p.x > W) p.x = 0;
        if (p.y < 0) p.y = H;
        if (p.y > H) p.y = 0;

        // Draw particle
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${p.r},${p.g},${p.b},${p.opacity})`;
        ctx.fill();
      }

      // Connection lines
      for (let i = 0; i < particles.length; i++) {
        for (let j = i + 1; j < particles.length; j++) {
          const a = particles[i], b = particles[j];
          const dx = a.x - b.x, dy = a.y - b.y;
          const d = Math.sqrt(dx * dx + dy * dy);
          if (d < LINK_RADIUS) {
            const alpha = (1 - d / LINK_RADIUS) * Math.min(a.opacity, b.opacity) * 0.55;
            ctx.beginPath();
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(b.x, b.y);
            ctx.strokeStyle = `rgba(160,112,255,${alpha})`;
            ctx.lineWidth = 0.6;
            ctx.stroke();
          }
        }
      }

      requestAnimationFrame(draw);
    }

    draw();
  })();

  /* ── Count-up stats ── */
  function countUp(el: Element, target: number, duration: number) {
    const start = performance.now();
    function step(now: number) {
      const t = Math.min((now - start) / duration, 1);
      const ease = 1 - Math.pow(1 - t, 3);
      (el as HTMLElement).textContent = Math.floor(ease * target).toString();
      if (t < 1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }

  const statsBar = document.querySelector('.stats-bar');
  if (statsBar) {
    const io = new IntersectionObserver((entries) => {
      if (entries[0].isIntersecting) {
        document.querySelectorAll('.stat-num').forEach((el) => {
          const target = parseInt((el as HTMLElement).dataset.target || '0', 10);
          countUp(el, target, 1900);
        });
        io.disconnect();
      }
    }, { threshold: 0.4 });
    io.observe(statsBar);
  }
</script>

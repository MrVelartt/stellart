---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contacto — Stellart"
  description="Agenda una reunión de 30 minutos o descarga nuestra guía gratuita de arquitectura empresarial."
>

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="grid-bg"></div>
    <div class="container page-hero-inner">
      <p class="eyebrow fade-in-1">Contacto</p>
      <h1 class="fade-in-2">Hablemos de tu<br /><em>operación real</em>.</h1>
      <p class="page-hero-sub fade-in-3">
        30 minutos. Sin agenda comercial. Sin presentación de PowerPoint.
        Si podemos ayudarte, te lo diremos. Si no, también.
      </p>
    </div>
  </section>

  <!-- Contenido principal -->
  <section class="section contacto-section">
    <div class="container">
      <div class="contacto-grid">

        <!-- Formulario -->
        <div class="form-col scroll-reveal">
          <p class="form-label eyebrow">Agendar reunión</p>
          <h2 class="form-title">Cuéntanos de tu empresa.</h2>

          <form class="contact-form" id="contact-form">
            <div class="field-full">
              <label for="nombre">Nombre completo</label>
              <input type="text" id="nombre" name="nombre" placeholder="Tu nombre" required />
            </div>
            <div class="field-row">
              <div class="field">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" placeholder="tu@empresa.com" required />
              </div>
              <div class="field">
                <label for="empresa">Empresa</label>
                <input type="text" id="empresa" name="empresa" placeholder="Nombre de tu empresa" required />
              </div>
            </div>
            <div class="field-row">
              <div class="field">
                <label for="cargo">Cargo</label>
                <input type="text" id="cargo" name="cargo" placeholder="CEO, Director de Ops..." />
              </div>
              <div class="field">
                <label for="equipo">Tamaño del equipo</label>
                <select id="equipo" name="equipo">
                  <option value="" disabled selected>Selecciona</option>
                  <option value="20-50">20–50 personas</option>
                  <option value="50-100">50–100 personas</option>
                  <option value="100-500">100–500 personas</option>
                  <option value="500+">Más de 500</option>
                </select>
              </div>
            </div>
            <div class="field-full">
              <label for="servicio">¿Qué te interesa?</label>
              <select id="servicio" name="servicio">
                <option value="" disabled selected>Selecciona un servicio</option>
                <option value="diagnostico">Diagnóstico de arquitectura</option>
                <option value="software">Software a medida</option>
                <option value="kpis">Dashboards de KPIs</option>
                <option value="sin-saber">Aún no estoy seguro</option>
              </select>
            </div>
            <div class="field-full">
              <label for="descripcion">¿Cuál es tu principal desafío operativo?</label>
              <textarea id="descripcion" name="descripcion" rows="4" placeholder="Cuéntanos brevemente qué está frenando tu operación..."></textarea>
            </div>
            <button type="submit" class="btn btn-primary btn-arrow submit-btn">
              Enviar mensaje <span class="arrow">→</span>
            </button>
            <p class="form-note">
              <!-- Conectar con Formspree o Resend aquí -->
              Te responderemos en menos de 24 horas hábiles.
            </p>
          </form>
        </div>

        <!-- Info cards -->
        <div class="info-col">

          <!-- Contacto directo -->
          <div class="info-card scroll-reveal">
            <span class="info-card-label eyebrow">Contacto directo</span>
            <a href="mailto:hola@stellart.site" class="contact-email">hola@stellart.site</a>
          </div>

          <!-- Descarga -->
          <div class="info-card descarga-card scroll-reveal" id="descarga">
            <span class="eyebrow recurso-eyebrow">Recurso gratuito</span>
            <h3>Guía de arquitectura empresarial</h3>
            <p>PDF de 32 páginas con el marco que usamos en diagnósticos reales.</p>
            <ul class="recurso-lista">
              <li><span class="recurso-arrow">→</span> Marco de evaluación</li>
              <li><span class="recurso-arrow">→</span> Plantilla de mapa de sistemas</li>
              <li><span class="recurso-arrow">→</span> Checklist de auditoría</li>
              <li><span class="recurso-arrow">→</span> Cómo priorizar inversión técnica</li>
            </ul>
            <div class="descarga-form">
              <input type="email" placeholder="tu@empresa.com" class="descarga-input" />
              <button class="btn btn-primary">Descargar ↓</button>
            </div>
          </div>

          <!-- Ubicación -->
          <div class="info-card scroll-reveal">
            <span class="info-card-label eyebrow">Dónde operamos</span>
            <p class="ubicacion-text">Operamos remotamente con clientes en Latinoamérica. Reuniones presenciales bajo coordinación.</p>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section faq-section">
    <div class="container">
      <div class="section-header scroll-reveal">
        <p class="eyebrow">Preguntas frecuentes</p>
        <h2>Lo que <em>siempre</em><br />nos preguntan.</h2>
      </div>
      <div class="faq-list scroll-reveal">

        <details class="faq-item">
          <summary class="faq-summary">
            <h3>¿Cuánto cuesta empezar a trabajar con ustedes?</h3>
            <span class="faq-icon">+</span>
          </summary>
          <div class="faq-body">
            <p>El diagnóstico de arquitectura parte desde USD 2.500 con una duración de 2–3 semanas. No requiere comité interno ni procesos de aprobación complejos. Es un entregable independiente que puedes ejecutar con o sin nosotros después.</p>
          </div>
        </details>

        <details class="faq-item">
          <summary class="faq-summary">
            <h3>¿Trabajan con empresas pequeñas o solo grandes?</h3>
            <span class="faq-icon">+</span>
          </summary>
          <div class="faq-body">
            <p>Trabajamos con empresas que ya tienen operación establecida: equipos de 20 o más personas con procesos definidos pero con sistemas que no escalan. No trabajamos con startups en etapa temprana que todavía no tienen operación clara.</p>
          </div>
        </details>

        <details class="faq-item">
          <summary class="faq-summary">
            <h3>¿Qué pasa después del diagnóstico? ¿Estoy obligado a contratarlos?</h3>
            <span class="faq-icon">+</span>
          </summary>
          <div class="faq-body">
            <p>No. El diagnóstico es un entregable completamente independiente. Te llevas el informe ejecutivo y el roadmap y puedes ejecutarlo con tu equipo interno, con otros proveedores o con nosotros. Sin compromisos posteriores.</p>
          </div>
        </details>

        <details class="faq-item">
          <summary class="faq-summary">
            <h3>¿Cuánto tarda un proyecto típico?</h3>
            <span class="faq-icon">+</span>
          </summary>
          <div class="faq-body">
            <p>El diagnóstico toma 2–3 semanas. Los proyectos de software duran entre 2–6 meses con entregas cada 2–3 semanas. El setup de dashboards toma 3–6 semanas y luego pasa a mantenimiento mensual. Los tiempos exactos dependen del alcance definido en la propuesta.</p>
          </div>
        </details>

        <details class="faq-item">
          <summary class="faq-summary">
            <h3>¿Usan IA en sus servicios?</h3>
            <span class="faq-icon">+</span>
          </summary>
          <div class="faq-body">
            <p>Sí, cuando aporta valor real y medible. Construimos agentes para automatización de procesos, asistentes internos para equipos operativos y modelos de análisis de datos. No usamos IA como buzzword — la incorporamos cuando resuelve un problema concreto mejor que la alternativa tradicional.</p>
          </div>
        </details>

      </div>
    </div>
  </section>

</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      // TODO: Conectar con Formspree (action="https://formspree.io/f/...") o Resend
      alert('Mensaje recibido. Te contactaremos en menos de 24 horas hábiles.');
      form.reset();
    });
  }

  document.querySelectorAll('.faq-item').forEach((item) => {
    const summary = item.querySelector('.faq-summary');
    const icon = item.querySelector('.faq-icon');
    if (!summary || !icon) return;
    item.addEventListener('toggle', () => {
      icon.textContent = (item as HTMLDetailsElement).open ? '×' : '+';
    });
  });
</script>

<style>
  /* Page hero */
  .page-hero {
    position: relative;
    padding-top: 160px;
    padding-bottom: 100px;
    overflow: hidden;
  }

  .page-hero-inner {
    position: relative;
    z-index: 1;
    max-width: 700px;
  }

  .page-hero-inner .eyebrow {
    margin-bottom: 24px;
    display: flex;
  }

  .page-hero-inner h1 {
    margin-bottom: 24px;
  }

  .page-hero-sub {
    font-size: 18px;
    line-height: 1.7;
    font-weight: 300;
    max-width: 520px;
  }

  /* Contacto grid */
  .contacto-section {
    padding-top: 0;
  }

  .contacto-grid {
    display: grid;
    grid-template-columns: 1fr 420px;
    gap: 64px;
    align-items: start;
  }

  /* Form */
  .form-label {
    display: flex;
    margin-bottom: 12px;
  }

  .form-title {
    font-size: clamp(28px, 3vw, 40px);
    margin-bottom: 36px;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .field-full {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  label {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }

  input,
  select,
  textarea {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 6px;
    padding: 12px 16px;
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--text-primary);
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
    font-weight: 300;
    width: 100%;
  }

  input::placeholder,
  textarea::placeholder {
    color: var(--text-muted);
  }

  input:focus,
  select:focus,
  textarea:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(197, 247, 79, 0.1);
  }

  select option {
    background: var(--bg-elevated);
    color: var(--text-primary);
  }

  textarea {
    resize: vertical;
    min-height: 120px;
  }

  .submit-btn {
    align-self: flex-start;
    margin-top: 4px;
  }

  .form-note {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-muted);
    font-weight: 400;
  }

  /* Info cards */
  .info-col {
    display: flex;
    flex-direction: column;
    gap: 20px;
    position: sticky;
    top: 90px;
  }

  .info-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 12px;
    padding: 28px;
  }

  .info-card-label {
    display: flex;
    margin-bottom: 12px;
  }

  .contact-email {
    display: block;
    font-family: var(--font-display);
    font-size: 26px;
    color: var(--text-primary);
    text-decoration: none;
    transition: color 0.2s;
    line-height: 1.2;
  }

  .contact-email:hover {
    color: var(--accent);
  }

  /* Descarga card */
  .descarga-card {
    border-color: rgba(197, 247, 79, 0.2);
    background: linear-gradient(135deg, rgba(197, 247, 79, 0.04) 0%, var(--bg-card) 60%);
  }

  .recurso-eyebrow {
    display: flex;
    margin-bottom: 14px;
    color: var(--accent);
  }

  .recurso-eyebrow::before {
    color: var(--accent);
  }

  .descarga-card h3 {
    font-size: 20px;
    margin-bottom: 10px;
  }

  .descarga-card > p {
    font-size: 14px;
    font-weight: 300;
    margin-bottom: 20px;
  }

  .recurso-lista {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 24px;
  }

  .recurso-lista li {
    font-size: 13px;
    color: var(--text-secondary);
    font-weight: 300;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .recurso-arrow {
    color: var(--accent);
    font-size: 12px;
    flex-shrink: 0;
  }

  .descarga-form {
    display: flex;
    gap: 10px;
  }

  .descarga-input {
    flex: 1;
    min-width: 0;
  }

  .descarga-form .btn {
    flex-shrink: 0;
    white-space: nowrap;
    padding: 12px 18px;
    font-size: 13px;
  }

  .ubicacion-text {
    font-size: 15px;
    line-height: 1.65;
    font-weight: 300;
    margin-top: 8px;
  }

  /* FAQ */
  .faq-section {
    background: var(--bg-elevated);
    border-top: 1px solid var(--border-subtle);
  }

  .faq-list {
    border-top: 1px solid var(--border-subtle);
    max-width: 760px;
  }

  .faq-item {
    border-bottom: 1px solid var(--border-subtle);
  }

  .faq-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 28px 0;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-summary h3 {
    font-size: clamp(18px, 2vw, 24px);
    font-weight: 400;
    color: var(--text-primary);
    transition: color 0.2s;
  }

  .faq-summary:hover h3 {
    color: var(--accent);
  }

  .faq-icon {
    font-family: var(--font-mono);
    font-size: 20px;
    color: var(--text-muted);
    flex-shrink: 0;
    transition: color 0.2s, transform 0.2s;
    line-height: 1;
  }

  .faq-item[open] .faq-icon {
    color: var(--accent);
  }

  .faq-body {
    padding-bottom: 28px;
  }

  .faq-body p {
    font-size: 15px;
    line-height: 1.75;
    font-weight: 300;
    max-width: 640px;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .contacto-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .info-col {
      position: static;
    }
  }

  @media (max-width: 768px) {
    .page-hero {
      padding-top: 120px;
      padding-bottom: 60px;
    }

    .field-row {
      grid-template-columns: 1fr;
    }

    .descarga-form {
      flex-direction: column;
    }
  }
</style>

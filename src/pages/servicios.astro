---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Soluciones — Agentes IA, Software y Automatización Empresarial | Stellart Corp"
  description="Cuatro líneas de soluciones: Diagnóstico, IA Operacional con agentes, Software a medida y Marketing con IA. Automatización empresarial en Colombia desde Villavicencio."
  canonicalPath="/servicios"
>

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="grid-bg"></div>
    <div class="container page-hero-inner">
      <p class="eyebrow fade-in-1">Soluciones</p>
      <h1 class="fade-in-2">Cuatro líneas.<br /><em>Una sola operación</em>.</h1>
      <p class="page-hero-sub fade-in-3">
        No vendemos módulos sueltos. Cada solución que construimos conecta con la siguiente.
        Diagnóstico, IA operacional, software propio y captación automatizada — desde Villavicencio para cualquier empresa de Colombia.
      </p>
    </div>
  </section>

  <!-- Diagnóstico -->
  <section id="diagnostico" class="servicio-bloque bg-base">
    <div class="container">
      <div class="bloque-grid scroll-reveal">
        <div class="bloque-left">
          <span class="bloque-tag">01 — Diagnóstico</span>
          <h2>Diagnóstico de arquitectura empresarial</h2>
          <p class="bloque-desc">
            Antes de construir cualquier cosa, entendemos. En 2–3 semanas hacemos un mapeo completo de tu
            operación: sistemas, datos, procesos y personas. El resultado es un informe ejecutivo
            accionable que tu equipo puede ejecutar con o sin nosotros.
          </p>
          <div class="bloque-meta">
            <div class="meta-item">
              <span class="meta-label">Duración</span>
              <span class="meta-value">2–3 semanas</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Modalidad</span>
              <span class="meta-value">Remoto + 2 sesiones in-situ</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Inversión</span>
              <span class="meta-value">Desde USD 2.500</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Entregable</span>
              <span class="meta-value">Informe ejecutivo + roadmap</span>
            </div>
          </div>
          <a href="/contacto" class="btn btn-primary btn-arrow">Agenda tu diagnóstico gratis <span class="arrow">→</span></a>
        </div>
        <div class="bloque-right">
          <ul class="bloque-items">
            <li class="bloque-item">
              <span class="item-num">1</span>
              <div>
                <h4>Inventario técnico</h4>
                <p>Mapeo completo de sistemas, integraciones, datos y dependencias.</p>
              </div>
            </li>
            <li class="bloque-item">
              <span class="item-num">2</span>
              <div>
                <h4>Análisis de procesos</h4>
                <p>Entrevistas con líderes operativos para identificar fricciones reales.</p>
              </div>
            </li>
            <li class="bloque-item">
              <span class="item-num">3</span>
              <div>
                <h4>Auditoría de datos</h4>
                <p>Calidad, consistencia y trazabilidad de la información crítica.</p>
              </div>
            </li>
            <li class="bloque-item">
              <span class="item-num">4</span>
              <div>
                <h4>Identificación de brechas</h4>
                <p>Lista priorizada de problemas técnicos por impacto y urgencia.</p>
              </div>
            </li>
            <li class="bloque-item">
              <span class="item-num">5</span>
              <div>
                <h4>Roadmap accionable</h4>
                <p>Plan de 6–12 meses con estimaciones, dependencias y retornos esperados.</p>
              </div>
            </li>
            <li class="bloque-item">
              <span class="item-num">6</span>
              <div>
                <h4>Presentación ejecutiva</h4>
                <p>Sesión final con liderazgo para defender el plan ante stakeholders.</p>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- IA Operacional -->
  <section id="ia" class="servicio-bloque bg-elevated">
    <div class="container">
      <div class="bloque-grid bloque-grid-reverse scroll-reveal">
        <div class="bloque-left">
          <span class="bloque-tag">02 — IA Operacional</span>
          <h2>Agentes IA y automatización empresarial Colombia</h2>
          <p class="bloque-desc">
            Construimos agentes IA que operan dentro de tu empresa: responden clientes en WhatsApp,
            procesan documentos, generan reportes y toman decisiones de primer nivel sin intervención humana.
            Vibe engineering aplicado a operaciones reales en Colombia y Latinoamérica.
          </p>
          <div class="bloque-meta">
            <div class="meta-item">
              <span class="meta-label">Duración</span>
              <span class="meta-value">3–8 semanas</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Modalidad</span>
              <span class="meta-value">Remoto 100%</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Inversión</span>
              <span class="meta-value">Desde USD 3.500</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Entregable</span>
              <span class="meta-value">Agente en producción + tablero KPIs</span>
            </div>
          </div>
          <a href="/contacto" class="btn btn-primary btn-arrow">Construir mi agente IA <span class="arrow">→</span></a>
        </div>
        <div class="bloque-right">
          <ul class="bloque-items">
            <li class="bloque-item">
              <span class="item-num">1</span>
              <div>
                <h4>Agentes de atención al cliente</h4>
                <p>WhatsApp, web, email. Responden, califican y escalan sin humano de por medio.</p>
              </div>
            </li>
            <li class="bloque-item">
              <span class="item-num">2</span>
              <div>
                <h4>Automatización de procesos internos</h4>
                <p>Flujos que eliminan trabajo manual repetitivo: aprobaciones, reportes, alertas.</p>
              </div>
            </li>
            <li class="bloque-item">
              <span class="item-num">3</span>
              <div>
                <h4>Tableros de KPIs en tiempo real</h4>
                <p>Una sola superficie de decisión. Todos los datos de la operación visibles al instante.</p>
              </div>
            </li>
            <li class="bloque-item">
              <span class="item-num">4</span>
              <div>
                <h4>Análisis de datos con IA</h4>
                <p>Modelos que detectan patrones, predicen demanda y alertan antes del problema.</p>
              </div>
            </li>
            <li class="bloque-item">
              <span class="item-num">5</span>
              <div>
                <h4>Integraciones y pipelines</h4>
                <p>Conectamos el agente con tus sistemas existentes. Sin romper lo que ya funciona.</p>
              </div>
            </li>
            <li class="bloque-item">
              <span class="item-num">6</span>
              <div>
                <h4>Vibe coding Colombia</h4>
                <p>Desarrollo acelerado con IA. Tiempo de construcción 3–5x más rápido que métodos tradicionales.</p>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Software -->
  <section id="software" class="servicio-bloque bg-base">
    <div class="container">
      <div class="bloque-grid scroll-reveal">
        <div class="bloque-left">
          <span class="bloque-tag">03 — Software</span>
          <h2>Software a medida — sistemas propios</h2>
          <p class="bloque-desc">
            Construimos los sistemas que tu operación necesita y que no existen como SaaS genérico.
            ERPs ligeros, CRMs especializados, plataformas operativas únicas. Sprints cortos, entregas frecuentes,
            sistema en producción que realmente se usa.
          </p>
          <div class="bloque-meta">
            <div class="meta-item">
              <span class="meta-label">Duración</span>
              <span class="meta-value">2–6 meses por sprint</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Metodología</span>
              <span class="meta-value">Sprints de 2–3 semanas</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Inversión</span>
              <span class="meta-value">Desde USD 8.000</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Entregable</span>
              <span class="meta-value">Sistema en producción</span>
            </div>
          </div>
          <a href="/contacto" class="btn btn-primary btn-arrow">Hablar de tu proyecto <span class="arrow">→</span></a>
        </div>
        <div class="bloque-right">
          <ul class="bloque-items">
            <li class="bloque-item">
              <span class="item-num">1</span>
              <div>
                <h4>Sistemas internos a medida</h4>
                <p>ERPs ligeros, CRMs especializados, plataformas operativas únicas para tu sector.</p>
              </div>
            </li>
            <li class="bloque-item">
              <span class="item-num">2</span>
              <div>
                <h4>Integraciones entre sistemas</h4>
                <p>Conectamos tus herramientas existentes para que dejen de operar en silos.</p>
              </div>
            </li>
            <li class="bloque-item">
              <span class="item-num">3</span>
              <div>
                <h4>Automatización de procesos</h4>
                <p>Flujos que eliminan tareas manuales repetitivas y reducen errores humanos.</p>
              </div>
            </li>
            <li class="bloque-item">
              <span class="item-num">4</span>
              <div>
                <h4>Portales para clientes y proveedores</h4>
                <p>Interfaces que profesionalizan la relación con terceros y reducen fricción.</p>
              </div>
            </li>
            <li class="bloque-item">
              <span class="item-num">5</span>
              <div>
                <h4>APIs y microservicios</h4>
                <p>Infraestructura para escalar y permitir que otros sistemas se conecten.</p>
              </div>
            </li>
            <li class="bloque-item">
              <span class="item-num">6</span>
              <div>
                <h4>Migraciones técnicas</h4>
                <p>De sistemas legacy a stacks modernos sin interrumpir la operación.</p>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Marketing con IA -->
  <section id="marketing" class="servicio-bloque bg-elevated">
    <div class="container">
      <div class="bloque-grid bloque-grid-reverse scroll-reveal">
        <div class="bloque-left">
          <span class="bloque-tag">04 — Marketing con IA</span>
          <h2>Captación automatizada con inteligencia artificial</h2>
          <p class="bloque-desc">
            Meta Ads optimizados con IA, SEO técnico para posicionar en Google y automatización
            del funnel de captación. Clientes que llegan solos mientras la operación trabaja.
            Automatización empresarial Colombia aplicada al crecimiento comercial.
          </p>
          <div class="bloque-meta">
            <div class="meta-item">
              <span class="meta-label">Duración setup</span>
              <span class="meta-value">4–6 semanas</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Modalidad</span>
              <span class="meta-value">Remoto 100%</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Inversión</span>
              <span class="meta-value">Desde USD 1.800/mes</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Entregable</span>
              <span class="meta-value">Pipeline de captación activo</span>
            </div>
          </div>
          <a href="/contacto" class="btn btn-primary btn-arrow">Automatizar mi captación <span class="arrow">→</span></a>
        </div>
        <div class="bloque-right">
          <ul class="bloque-items">
            <li class="bloque-item">
              <span class="item-num">1</span>
              <div>
                <h4>Meta Ads con IA</h4>
                <p>Campañas de Facebook e Instagram optimizadas automáticamente. Menos desperdicio, más conversión.</p>
              </div>
            </li>
            <li class="bloque-item">
              <span class="item-num">2</span>
              <div>
                <h4>SEO técnico</h4>
                <p>Posicionamiento en Google para keywords de negocio. Tráfico orgánico que convierte.</p>
              </div>
            </li>
            <li class="bloque-item">
              <span class="item-num">3</span>
              <div>
                <h4>Automatización del funnel</h4>
                <p>Lead scoring, nurturing y seguimiento automático. El prospecto avanza solo.</p>
              </div>
            </li>
            <li class="bloque-item">
              <span class="item-num">4</span>
              <div>
                <h4>Agente de captación WhatsApp</h4>
                <p>Responde, califica y agenda reuniones por WhatsApp sin intervención humana.</p>
              </div>
            </li>
            <li class="bloque-item">
              <span class="item-num">5</span>
              <div>
                <h4>Contenido generado con IA</h4>
                <p>Copy, creativos y variaciones de anuncio generados y testeados automáticamente.</p>
              </div>
            </li>
            <li class="bloque-item">
              <span class="item-num">6</span>
              <div>
                <h4>Dashboard de marketing</h4>
                <p>CAC, LTV, ROAS y pipeline en tiempo real. Decisiones de pauta con datos, no intuición.</p>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Proceso -->
  <section class="section proceso bg-elevated">
    <div class="container">
      <div class="section-header scroll-reveal">
        <p class="eyebrow">Proceso</p>
        <h2>Así arranca<br />cualquier <em>proyecto</em>.</h2>
      </div>
      <div class="proceso-grid">
        <div class="proceso-paso scroll-reveal">
          <span class="paso-num">01</span>
          <h3>Diagnóstico gratis</h3>
          <p>30 minutos. Nos cuentas tu operación, te decimos exactamente qué construir. Sin compromiso.</p>
        </div>
        <div class="proceso-paso scroll-reveal">
          <span class="paso-num">02</span>
          <h3>Propuesta concreta</h3>
          <p>En 5 días hábiles: alcance, metodología y precio fijo. Sin sorpresas.</p>
        </div>
        <div class="proceso-paso scroll-reveal">
          <span class="paso-num">03</span>
          <h3>Arranque rápido</h3>
          <p>Primera entrega en 2–3 semanas. La operación empieza a cambiar de inmediato.</p>
        </div>
        <div class="proceso-paso scroll-reveal">
          <span class="paso-num">04</span>
          <h3>Capacidad que crece</h3>
          <p>Cada solución que construimos habilita la siguiente. El sistema se vuelve más inteligente con el tiempo.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Final -->
  <section class="section cta-final">
    <div class="container">
      <div class="cta-box scroll-reveal">
        <p class="eyebrow">Primer paso</p>
        <h2>Empieza con un<br /><em>diagnóstico gratis</em>.</h2>
        <p class="cta-desc">
          30 minutos. Te decimos qué construir primero y cuánto cuesta. Sin venderte lo que no necesitas.
          Stellart Corp opera desde Villavicencio para empresas en toda Colombia y Latinoamérica.
        </p>
        <div class="cta-btns">
          <a href="/contacto" class="btn btn-primary btn-arrow">Agenda tu diagnóstico gratis <span class="arrow">→</span></a>
          <a href="/agentes-ia-villavicencio" class="btn btn-secondary">Ver Agentes IA</a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* Page hero */
  .page-hero {
    position: relative;
    padding-top: 160px;
    padding-bottom: 100px;
    overflow: hidden;
  }

  .page-hero-inner {
    position: relative;
    z-index: 1;
    max-width: 760px;
  }

  .page-hero-inner .eyebrow {
    margin-bottom: 24px;
    display: flex;
  }

  .page-hero-inner h1 {
    margin-bottom: 24px;
  }

  .page-hero-sub {
    font-size: 18px;
    line-height: 1.7;
    font-weight: 300;
    max-width: 560px;
  }

  /* Bloques de servicio */
  .servicio-bloque {
    padding: 100px 0;
    border-top: 1px solid var(--border-subtle);
  }

  .bg-base {
    background: var(--bg);
  }

  .bg-elevated {
    background: var(--bg-elevated);
  }

  .bloque-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
  }

  .bloque-grid-reverse {
    direction: rtl;
  }

  .bloque-grid-reverse > * {
    direction: ltr;
  }

  .bloque-tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
    margin-bottom: 20px;
  }

  .bloque-left h2 {
    font-size: clamp(28px, 3vw, 44px);
    margin-bottom: 20px;
    line-height: 1.15;
  }

  .bloque-desc {
    font-size: 16px;
    line-height: 1.75;
    font-weight: 300;
    margin-bottom: 36px;
  }

  .bloque-meta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 36px;
    padding: 28px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-subtle);
    border-radius: 10px;
  }

  .meta-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    margin-bottom: 4px;
  }

  .meta-value {
    display: block;
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--text-primary);
    font-weight: 400;
  }

  /* Bloque items list */
  .bloque-items {
    list-style: none;
    border-top: 1px solid var(--border-subtle);
  }

  .bloque-item {
    display: flex;
    gap: 20px;
    padding: 24px 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  .item-num {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    color: var(--accent);
    flex-shrink: 0;
    padding-top: 3px;
    text-shadow: 0 0 8px var(--accent-glow);
  }

  .bloque-item h4 {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 400;
    color: var(--text-primary);
    margin-bottom: 6px;
  }

  .bloque-item p {
    font-size: 14px;
    font-weight: 300;
    line-height: 1.6;
  }

  /* Proceso */
  .proceso-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--border-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: 12px;
    overflow: hidden;
  }

  .proceso-paso {
    background: var(--bg-card);
    padding: 36px 28px;
    border-top: 2px solid var(--accent);
  }

  .paso-num {
    display: block;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    color: var(--accent);
    margin-bottom: 16px;
    text-shadow: 0 0 8px var(--accent-glow);
  }

  .proceso-paso h3 {
    font-size: 20px;
    margin-bottom: 10px;
  }

  .proceso-paso p {
    font-size: 14px;
    line-height: 1.65;
    font-weight: 300;
  }

  /* CTA */
  .cta-final {
    background: var(--bg);
  }

  .cta-box {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 16px;
    padding: 80px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    position: relative;
    overflow: hidden;
  }

  .cta-box::before {
    content: '';
    position: absolute;
    bottom: -60px;
    left: 50%;
    transform: translateX(-50%);
    width: 480px;
    height: 200px;
    background: radial-gradient(ellipse at center, rgba(197, 247, 79, 0.18) 0%, transparent 70%);
    pointer-events: none;
  }

  .cta-box .eyebrow,
  .cta-box h2,
  .cta-desc,
  .cta-btns {
    position: relative;
    z-index: 1;
  }

  .cta-desc {
    font-size: 17px;
    line-height: 1.7;
    max-width: 520px;
    font-weight: 300;
  }

  .cta-btns {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    justify-content: center;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .bloque-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .bloque-grid-reverse {
      direction: ltr;
    }

    .proceso-grid {
      grid-template-columns: 1fr 1fr;
    }

    .cta-box {
      padding: 56px 48px;
    }
  }

  @media (max-width: 768px) {
    .page-hero {
      padding-top: 120px;
      padding-bottom: 60px;
    }

    .servicio-bloque {
      padding: 72px 0;
    }

    .bloque-meta {
      grid-template-columns: 1fr;
    }

    .proceso-grid {
      grid-template-columns: 1fr;
    }

    .cta-box {
      padding: 48px 28px;
    }
  }
</style>
